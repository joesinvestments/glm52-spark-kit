From 9cc7a3aa8f8b4445634f9ec632c89b51dba44138 Mon Sep 17 00:00:00 2001
From: bird <6666242+bird@users.noreply.github.com>
Date: Thu, 9 Jul 2026 11:00:51 -0400
Subject: [PATCH 13/17] dspark capture v2: raw per-layer aux hiddens +
 configurable rate

Training data must be the pre-projection target aux states (the draft
combine layer is itself trainable); VLLM_DSPARK_CAPTURE_EVERY tunes the
sampling rate (50 for organic serving, 2 for driven data runs).
---
 .../gpu/spec_decode/dflash/speculator.py      | 58 +++++++++++--------
 1 file changed, 34 insertions(+), 24 deletions(-)

diff --git a/vllm/v1/worker/gpu/spec_decode/dflash/speculator.py b/vllm/v1/worker/gpu/spec_decode/dflash/speculator.py
index 34413ef..ebb1364 100644
--- a/vllm/v1/worker/gpu/spec_decode/dflash/speculator.py
+++ b/vllm/v1/worker/gpu/spec_decode/dflash/speculator.py
@@ -141,6 +141,9 @@ class DFlashSpeculator(DraftModelSpeculator):
         import os as _os
 
         self._capture_dir = _os.environ.get("VLLM_DSPARK_CAPTURE_DIR", "")
+        self._capture_every = int(
+            _os.environ.get("VLLM_DSPARK_CAPTURE_EVERY", "50")
+        )
         if self._capture_dir:
             from vllm.distributed.parallel_state import (
                 get_tensor_model_parallel_rank,
@@ -423,35 +426,42 @@ class DFlashSpeculator(DraftModelSpeculator):
         self.hidden_states[:num_target_tokens].copy_(hidden_states[:num_target_tokens])
 
         if self._capture_dir and not dummy_run and num_target_tokens > 0:
-            # Speculator-finetune data: OUR target's combined aux hidden per
-            # accepted/context token, with ids and absolute positions. bf16,
-            # ~12KB/token; rank 0 only (TP-identical).
-            try:
-                import time as _time
-
-                payload = {
-                    "hidden": hidden_states[:num_target_tokens]
-                    .detach()
-                    .to(torch.bfloat16)
-                    .cpu(),
-                    "input_ids": self.input_buffers.input_ids[
-                        :num_target_tokens
-                    ]
-                    .detach()
-                    .cpu(),
-                    "positions": self.context_positions[:num_target_tokens]
-                    .detach()
-                    .cpu(),
-                }
-                self._capture_idx += 1
-                if self._capture_idx % 50 == 0:
+            # Speculator-finetune data: the RAW per-layer target aux hiddens
+            # (pre draft-projection - the draft's own trainable combine must
+            # not be baked in), token ids, absolute positions. bf16, rank 0.
+            self._capture_idx += 1
+            if aux_hidden_states and self._capture_idx % self._capture_every == 0:
+                try:
+                    import time as _time
+
+                    payload = {
+                        "aux": torch.cat(
+                            [
+                                a[:num_target_tokens].detach()
+                                for a in aux_hidden_states
+                            ],
+                            dim=-1,
+                        )
+                        .to(torch.bfloat16)
+                        .cpu(),
+                        "input_ids": self.input_buffers.input_ids[
+                            :num_target_tokens
+                        ]
+                        .detach()
+                        .cpu(),
+                        "positions": self.context_positions[
+                            :num_target_tokens
+                        ]
+                        .detach()
+                        .cpu(),
+                    }
                     torch.save(
                         payload,
                         f"{self._capture_dir}/cap-{int(_time.time()*1000)}"
                         f"-{self._capture_idx}.pt",
                     )
-            except Exception:
-                pass
+                except Exception:
+                    pass
 
         self._copy_request_inputs(
             num_reqs,
