 from vllm.platforms import current_platform
 from vllm.scalar_type import ScalarType, scalar_types
+
+
+# [glm52-collab][tailquant] Router-frequency profiler. When
+# VLLM_TAILQUANT_PROFILE_DIR is set, accumulate per-layer expert-hit histograms
+# from the live topk_ids at every MoE application, flushing JSON periodically.
+# Zero effect when unset. Layer attribution: one MarlinExperts instance per
+# layer; prefix when available, else stable per-instance id.
+_TQ = {"dir": None, "hists": {}, "tokens": 0}
+
+
+def _tq_record(owner, topk_ids):
+    d = _TQ["dir"]
+    if d is None:
+        _TQ["dir"] = d = os.environ.get("VLLM_TAILQUANT_PROFILE_DIR") or ""
+    if not d or topk_ids is None or topk_ids.numel() == 0:
+        return
+    try:
+        key = getattr(owner, "prefix", None) or f"inst{id(owner)}"
+        h = _TQ["hists"].get(key)
+        e = int(topk_ids.max().item()) + 1
+        if h is None or h.numel() < e:
+            grown = torch.zeros(max(e, h.numel() if h is not None else 0, 256),
+                                dtype=torch.long, device=topk_ids.device)
+            if h is not None:
+                grown[: h.numel()] = h
+            _TQ["hists"][key] = h = grown
+        flat = topk_ids.flatten().to(torch.long)
+        valid = flat[(flat >= 0) & (flat < h.numel())]
+        h += torch.bincount(valid, minlength=h.numel())[: h.numel()]
+        _TQ["tokens"] += int(topk_ids.size(0))
+        if _TQ["tokens"] - getattr(_TQ, "last_flush", 0) >= 65536:
+            import json as _json
+            import pathlib as _pl
+            out = _pl.Path(d)
+            out.mkdir(parents=True, exist_ok=True)
+            _json.dump({k: v.tolist() for k, v in _TQ["hists"].items()},
+                       open(out / "router_hist.json", "w"))
+            _TQ.last_flush = _TQ["tokens"]
+    except Exception:
+        pass
 
 
 def _fused_marlin_moe(
@@ -791,6 +831,7 @@
     ):
         assert self.w1_scale is not None
         assert self.w2_scale is not None
+        _tq_record(self, topk_ids)
 
