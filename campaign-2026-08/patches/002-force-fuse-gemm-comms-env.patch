+        # [glm52-collab] Env-forced async TP. On public v0.27.0 + Ray, user
+        # pass_config delivered through --compilation-config has been observed
+        # lost between the API layer and EngineCore (every fusion pass
+        # resolves False engine-side; see 0xdfi/glm-5.2-dgx-spark-vllm027
+        # issue #1). An env var survives every config-reconstruction path
+        # because workers inherit the serving container environment. Unset
+        # means byte-identical stock behavior.
+        if os.environ.get("VLLM_FORCE_FUSE_GEMM_COMMS", "").strip().lower() in (
+            "1",
+            "true",
+            "yes",
+            "on",
+        ):
+            if not self.pass_config.fuse_gemm_comms:
+                logger.warning_once(
+                    "VLLM_FORCE_FUSE_GEMM_COMMS=1: forcing pass_config."
+                    "fuse_gemm_comms=True (async TP; implies enable_sp). "
+                    "Value before force: %s",
+                    self.pass_config.fuse_gemm_comms,
+                )
+                self.pass_config.fuse_gemm_comms = True
+            else:
+                logger.info_once(
+                    "VLLM_FORCE_FUSE_GEMM_COMMS=1: fuse_gemm_comms was "
+                    "already True; user pass_config reached this construction "
+                    "site intact."
+                )
