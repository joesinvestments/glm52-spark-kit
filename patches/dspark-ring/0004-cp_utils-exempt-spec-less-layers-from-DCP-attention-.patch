From dd26ab3a72bd2d2eae61232ecf2eaae24ca87df8 Mon Sep 17 00:00:00 2001
From: bird <6666242+bird@users.noreply.github.com>
Date: Thu, 9 Jul 2026 03:30:02 -0400
Subject: [PATCH 04/17] cp_utils: exempt spec-less layers from DCP attention
 checks

Ring-mode DSpark draft layers register no KV cache spec; they hold a
local window cache and never shard KV across DCP ranks, so the LSE
requirement does not apply (same reasoning as the dcp_replicated skip).
---
 vllm/v1/worker/cp_utils.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/vllm/v1/worker/cp_utils.py b/vllm/v1/worker/cp_utils.py
index 7bb1f29..40df6ac 100644
--- a/vllm/v1/worker/cp_utils.py
+++ b/vllm/v1/worker/cp_utils.py
@@ -31,7 +31,9 @@ def check_attention_cp_compatibility(vllm_config: VllmConfig) -> None:
                     spec = get_spec(vllm_config)
                 except Exception:
                     spec = None
-                if getattr(spec, "dcp_replicated", False):
+                if spec is None or getattr(spec, "dcp_replicated", False):
+                    # spec None: layer owns no allocator KV at all (e.g. the
+                    # DSpark ring-buffer draft) - DCP sharding cannot apply.
                     continue
             if vllm_config.speculative_config is not None and interleave_size > 1:
                 assert layer_impl.supports_mtp_with_cp_non_trivial_interleave_size, (
